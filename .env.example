# Copiez ce fichier en ".env" et renseignez vos propres valeurs.

# Adresse IP ou hostname du node Meshtastic (obligatoire)
MESHTASTIC_HOST=192.168.1.50

# Port TCP de l'API Meshtastic (optionnel, défaut: 4403)
MESHTASTIC_PORT=4403

# Nom du canal Meshtastic cible (optionnel, défaut: meteo)
MESHTASTIC_CHANNEL_NAME=meteo

# Index de canal à utiliser si le nom ne peut pas être résolu automatiquement (optionnel)
#MESHTASTIC_CHANNEL_INDEX=2

# Ville et coordonnées pour la météo (optionnel, défaut: Rouen)
METEO_VILLE=Rouen
METEO_LAT=49.4432
METEO_LON=1.0999

# Format du message : "compact" (une ligne) ou "card" (mini tableau de bord
# multi-lignes). Optionnel, défaut: compact.
MESSAGE_STYLE=compact

# Ping ICMP de réveil du node avant la connexion TCP (optionnel, défaut: true)
PING_BEFORE_SEND=true
PING_TIMEOUT_S=2

# Délai (s) laissé après l'envoi avant de fermer la connexion TCP, pour
# laisser le temps au message d'être réellement transmis (optionnel, défaut: 2)
SEND_SETTLE_SECONDS=2

# --- Uniquement utilisé par le conteneur Docker (scheduler.py) ---

# Heure et minute d'exécution quotidienne, heure de Paris (optionnel, défaut: 8h00)
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# Si "true", exécute aussi une publication immédiate au démarrage du conteneur
# (pratique pour vérifier rapidement que tout fonctionne). Défaut: false.
RUN_ON_STARTUP=false
